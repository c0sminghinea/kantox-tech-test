		{
			"name": "Posts",
			"item": [
				{
					"name": "GET all posts",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test(\"Response is an array\", function () {",
									"    pm.expect(pm.response.json()).to.be.an('array');",
									"});",
									"",
									"pm.test(\"Array contains at least one post\", function () {",
									"    const jsonData = pm.response.json();",
									"    pm.expect(jsonData.length).to.be.at.least(1);",
									"});",
									"",
									"",
									"const posts = pm.response.json();",
									"",
									"pm.test(\"Response contains posts\", function () {",
									"    pm.expect(posts).to.be.an('array').that.is.not.empty;",
									"});",
									"",
									"// Select a random post ID",
									"const randomIndex = Math.floor(Math.random() * posts.length);",
									"const randomPostId = posts[randomIndex].id;",
									"",
									"// Store the random post ID in an environment variable",
									"pm.environment.set(\"randomPostId\", randomPostId);",
									"",
									"// Test the selected post ID",
									"pm.test(\"Selected random post ID is valid\", function () {",
									"    pm.expect(randomPostId).to.be.a('string');",
									"});",
									""
								],
								"type": "text/javascript",
								"packages": {}
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{url}}posts/",
							"host": [
								"{{url}}posts"
							],
							"path": [
								""
							]
						}
					},
					"response": []
				},
